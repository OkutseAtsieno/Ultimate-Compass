# Copy this file to .env and fill in real values before running compose.
# Never commit the real .env.

# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 0 = production (default), 1 = development with debug pages
DJANGO_DEBUG=0

# Hosts/domains this instance serves. Comma separated. No scheme, no slashes.
DJANGO_ALLOWED_HOSTS=ultimatecompass.co.ke

# CSRF trusted origins. Comma separated. MUST include scheme.
DJANGO_CSRF_ORIGINS=https://ultimatecompass.co.ke

# Set to 0 while bringing the site up for the first time, 1 once HTTPS is confirmed working.
DJANGO_SSL_REDIRECT=1

# Contact-form SMTP (Gmail App Password, not the normal Gmail password).
# Leaving these empty makes the contact form print to the container log instead of actually emailing.
EMAIL_HOST_USER=atsienookutse@gmail.com
EMAIL_HOST_PASSWORD=
CONTACT_RECEIVER=atsienookutse@gmail.com
